+import process from "node:process";
+
+const repoRoot = realpathSync(resolve(dirname(new URL(import.meta.url).pathname), ".."));
+const defaultManifest = "packaging/codex-runtime-macos-arm64.json";
+const defaultReceipt = "docs/evidence/codex-harness-source-provenance.json";
+const maxInputBytes = 64 * 1024 * 1024;
+const expectedUpstream = {
+  repository: "https://github.com/openai/codex",
+  ref: "refs/tags/rust-v0.146.0-alpha.3.1",
+  tagObjectSha: "1128ef2c0eec791d1c6aeff0ecbb9f3f89b0aab2",
+  tagVerification: "unsigned",
+  commitSha: "ff75c5b939c477c49eb1bd5248da6dab71b109d1",
+  treeSha: "556ecec1e52bfb0636d8341514e42a46c8b639de",
+  appServerTreeSha: "4607330553f2d168e82031ba3870ddde1f918cb1",
+  appServerProtocolTreeSha: "d8e9f888b7e83ca1bf0ce4293dfe847fd26063ed",
+  cargoLockSha256: "34214ee2b9cace59afb45de33b602baea2a3945bdb74dcda189e7f93b10e8e51",
+  licenseSha256: "d17f227e4df5da1600391338865ce0f3055211760a36688f816941d58232d8dc",
+  noticeSha256: "9d71575ecfd9a843fc1677b0efb08053c6ba9fd686a0de1a6f5382fd3c220915",
+  schemaRoot: "codex-rs/app-server-protocol/schema/json",
+  schemaFileCount: 273,
+  schemaManifestSha256: "6a08a7d625a1a2dd6d07828d7042dc642ed5ede5347bb120f58d4f7816e63a98",
+  canonicalSchemaTreeSha256: "410e1dcd7f3ce56cc77e3a18889b6f91d9760efb52fe735a4f9f05937c5261b0",
+  sourceReceiptSha256: "29a457629178353296121ff45a756cca964d4fb61eb5db926522e5b5e585170d",
+  sourceRelationship: "official-release-reference-not-reproducibly-built",
+};
+
+function fail(message) {
+  throw new Error(message);
+}
+
+function inputPath(value) {
+  return isAbsolute(value) ? value : resolve(repoRoot, value);
+}
+
+function exactKeys(value, expected, label) {
+  if (!value || typeof value !== "object" || Array.isArray(value)) fail(`${label} is not an object`);
+  const actual = Object.keys(value).sort();
+  const wanted = [...expected].sort();
+  if (JSON.stringify(actual) !== JSON.stringify(wanted)) fail(`${label} has missing or unknown fields`);
+}
+
+function sameStringMap(actual, expected) {
+  return Object.keys(expected).every((key) => actual[key] === expected[key]);
+}
+
+function stableBytes(path, label) {
+  if (!existsSync(path) || lstatSync(path).isSymbolicLink() || !statSync(path).isFile()) {
+    fail(`${label} is missing, symlinked, or not a regular file`);
+  }
+  const beforePath = statSync(path);
+  if (beforePath.nlink !== 1 || beforePath.size > maxInputBytes) fail(`${label} metadata is invalid`);
+  const descriptor = openSync(path, constants.O_RDONLY | constants.O_NOFOLLOW);
+  try {
+    const before = fstatSync(descriptor);
+    if (before.dev !== beforePath.dev || before.ino !== beforePath.ino || before.size !== beforePath.size) {
+      fail(`${label} changed before reading`);
+    }
+    const bytes = Buffer.allocUnsafe(before.size);
+    let copied = 0;
+    while (copied < bytes.length) {
+      const read = readSync(descriptor, bytes, copied, bytes.length - copied, copied);
+      if (read <= 0) fail(`${label} changed while reading`);
+      copied += read;
+    }
+    if (readSync(descriptor, Buffer.allocUnsafe(1), 0, 1, copied) !== 0) fail(`${label} grew while reading`);
+    const after = fstatSync(descriptor);
+    if (
+      before.dev !== after.dev || before.ino !== after.ino || before.size !== after.size ||
+      before.mtimeMs !== after.mtimeMs || before.ctimeMs !== after.ctimeMs
+    ) fail(`${label} changed while reading`);
+    return bytes;
+  } finally {
+    closeSync(descriptor);
+  }
+}
+
+function json(path, label) {
+  return JSON.parse(stableBytes(path, label).toString("utf8"));
+}
+
+function sha256Bytes(bytes) {
+  return createHash("sha256").update(bytes).digest("hex");
+}
+
+function sha256File(path, label) {
+  return sha256Bytes(stableBytes(path, label));
+}
+
+function canonicalJson(value) {
+  if (Array.isArray(value)) return value.map(canonicalJson);
+  if (!value || typeof value !== "object") return value;
+  return Object.fromEntries(
+    Object.keys(value)
+      .sort((left, right) => (left < right ? -1 : left > right ? 1 : 0))
+      .map((key) => [key, canonicalJson(value[key])]),
+  );
+}
+
+function canonicalJsonSha256(bytes, label) {
+  const document = JSON.parse(bytes.toString("utf8"));
+  return sha256Bytes(Buffer.from(JSON.stringify(canonicalJson(document))));
+}
+
+function git(sourceRoot, args, label) {
+  const result = spawnSync("git", ["-C", sourceRoot, ...args], { encoding: "utf8" });
+  if (result.status !== 0) fail(`${label} failed`);
+  return result.stdout.trim();
+}
+
+function gitBlob(sourceRoot, commitSha, path, label) {
+  const result = spawnSync("git", ["-C", sourceRoot, "cat-file", "blob", `${commitSha}:${path}`], { encoding: null });
+  if (result.status !== 0 || !Buffer.isBuffer(result.stdout) || result.stdout.length > maxInputBytes) {
+    fail(`${label} is missing or exceeds the bounded Git blob size limit`);
+  }
+  return result.stdout;
+}
+
+function gitBlobSha256(sourceRoot, commitSha, path, label) {
+  return sha256Bytes(gitBlob(sourceRoot, commitSha, path, label));
+}
+
+function parseArgs(argv) {
+  const options = { manifest: defaultManifest, receipt: defaultReceipt, sourceRoot: null };
+  for (let index = 0; index < argv.length; index += 1) {
+    const flag = argv[index];
+    if (flag === "--help") {
+      process.stdout.write("usage: check-codex-harness-source.mjs --source-root <clean-git-checkout> [--manifest <file>] [--receipt <file>]\n");
+      process.exit(0);
+    }
+    if (!["--manifest", "--receipt", "--source-root"].includes(flag)) fail(`unknown option: ${flag}`);
+    const value = argv[index + 1];
+    if (!value || value.startsWith("--")) fail(`missing value for ${flag}`);
+    options[flag.slice(2).replace(/-([a-z])/g, (_, character) => character.toUpperCase())] = value;
+    index += 1;
+  }
+  if (!options.sourceRoot) fail("--source-root is required");
+  return options;
+}
+
+function verifyUpstreamShape(upstream, label) {
+  exactKeys(upstream, [
+    "repository", "ref", "tagObjectSha", "tagVerification", "commitSha", "treeSha",
+    "appServerTreeSha", "appServerProtocolTreeSha", "cargoLockSha256", "licenseSha256",
+    "noticeSha256", "schemaRoot", "schemaFileCount", "schemaManifestSha256", "canonicalSchemaTreeSha256",
+    "sourceReceiptSha256", "sourceRelationship",
+  ], label);
+}
+
+function verifyReceipt(receipt, upstream) {
+  exactKeys(receipt, ["schemaVersion", "status", "upstream", "content", "sourceRelationship", "runtimeActivationChanged", "wholeProductParity"], "source receipt");
+  exactKeys(receipt.upstream, ["repository", "ref", "tagObjectSha", "tagVerification", "commitSha", "treeSha", "appServerTreeSha", "appServerProtocolTreeSha"], "source receipt upstream");
+  exactKeys(receipt.content, ["cargoLockSha256", "licenseSha256", "noticeSha256", "schemaRoot", "schemaFileCount", "schemaManifestSha256", "canonicalSchemaTreeSha256"], "source receipt content");
+  if (
+    receipt.schemaVersion !== 1 ||
+    receipt.status !== "PASS_PINNED_UPSTREAM_SOURCE" ||
+    receipt.sourceRelationship !== upstream.sourceRelationship ||
+    receipt.runtimeActivationChanged !== false ||
+    receipt.wholeProductParity !== "PARTIAL"
+  ) fail("source receipt status drifted or overclaimed");
+  for (const [key, value] of Object.entries(receipt.upstream)) {
+    if (upstream[key] !== value) fail(`source receipt upstream drifted: ${key}`);
+  }
+  for (const [key, value] of Object.entries(receipt.content)) {
+    if (upstream[key] !== value) fail(`source receipt content drifted: ${key}`);
+  }
+}
+
+function schemaManifest(sourceRoot, upstream, trackedPaths) {
+  const digest = createHash("sha256");
+  for (const path of trackedPaths) {
+    if (!path.startsWith(`${upstream.schemaRoot}/`) || !path.endsWith(".json")) {
+      fail("schema tree contains an unexpected tracked path");
+    }
+    digest.update(`${gitBlobSha256(sourceRoot, upstream.commitSha, path, `schema file ${path}`)}  ${path}\n`);
+  }
+  return digest.digest("hex");
+}
+
+function canonicalSchemaTree(sourceRoot, upstream, trackedPaths) {
+  const digest = createHash("sha256");
+  for (const path of trackedPaths) {
+    const relativePath = path.slice(upstream.schemaRoot.length + 1);
+    const bytes = gitBlob(sourceRoot, upstream.commitSha, path, `schema JSON ${path}`);
+    digest.update(`${canonicalJsonSha256(bytes, `schema JSON ${path}`)}  ${relativePath}\n`);
+  }
+  return digest.digest("hex");
+}
+
+function main() {
+  const options = parseArgs(process.argv.slice(2));
+  const manifest = json(inputPath(options.manifest), "runtime manifest");
+  exactKeys(manifest, ["manifestVersion", "runtimeId", "origin", "upstream", "package", "packageVersion", "packageSpecifier", "packageIntegrity", "packageShasum", "packagePackedBytes", "packageUnpackedBytes", "packageFileCount", "version", "targetTriple", "runtimeRootRelativePath", "executableRelativePath", "upstreamTeamId", "upstreamDesignatedRequirement", "upstreamBinarySha256", "schemaBundleSha256", "canonicalSchemaTreeSha256", "runtimeTreeSha256", "runtimeFiles", "license", "activation", "rollback"], "runtime manifest");
+  verifyUpstreamShape(manifest.upstream, "runtime manifest upstream");
+  const upstream = manifest.upstream;
+  if (!sameStringMap(upstream, expectedUpstream)) fail("runtime manifest uses a non-pinned upstream identity");
+  if (
+    upstream.repository !== "https://github.com/openai/codex" ||
+    upstream.ref !== `refs/tags/rust-v${manifest.version}` ||
+    upstream.ref.includes("main") || upstream.ref.includes("latest") ||
+    upstream.tagVerification !== "unsigned" ||
+    upstream.sourceRelationship !== "official-release-reference-not-reproducibly-built"
+  ) fail("runtime manifest uses an unaccepted upstream identity");
+  if (upstream.canonicalSchemaTreeSha256 !== manifest.canonicalSchemaTreeSha256) {
+    fail("source and runtime canonical schema trees are not bound");
+  }
+
+  const receipt = json(inputPath(options.receipt), "source receipt");
+  if (sha256File(inputPath(options.receipt), "source receipt") !== upstream.sourceReceiptSha256) fail("source receipt hash drifted");
+  verifyReceipt(receipt, upstream);
+
+  const sourceRoot = realpathSync(inputPath(options.sourceRoot));
+  if (!statSync(sourceRoot).isDirectory() || !existsSync(resolve(sourceRoot, ".git"))) fail("source root is not a Git checkout");
+  const remote = git(sourceRoot, ["remote", "get-url", "origin"], "source remote").replace(/\.git$/, "");
+  if (remote !== upstream.repository) fail("source remote drifted");
+  if (git(sourceRoot, ["status", "--porcelain=v1", "--untracked-files=all"], "source status") !== "") fail("source checkout is dirty");
+  if (git(sourceRoot, ["rev-parse", "HEAD"], "source HEAD") !== upstream.commitSha) fail("source HEAD drifted");
+  if (git(sourceRoot, ["cat-file", "-t", upstream.ref], "source tag type") !== "tag") fail("source ref is not the pinned annotated tag");
+  if (git(sourceRoot, ["rev-parse", upstream.ref], "source tag object") !== upstream.tagObjectSha) fail("source tag object drifted");
+  if (git(sourceRoot, ["rev-parse", `${upstream.ref}^{commit}`], "source peeled commit") !== upstream.commitSha) fail("source peeled commit drifted");
+  if (git(sourceRoot, ["rev-parse", `${upstream.commitSha}^{tree}`], "source root tree") !== upstream.treeSha) fail("source root tree drifted");
+  if (git(sourceRoot, ["rev-parse", `${upstream.commitSha}:codex-rs/app-server`], "App Server tree") !== upstream.appServerTreeSha) fail("App Server tree drifted");
+  if (git(sourceRoot, ["rev-parse", `${upstream.commitSha}:codex-rs/app-server-protocol`], "App Server protocol tree") !== upstream.appServerProtocolTreeSha) fail("App Server protocol tree drifted");
+
+  if (gitBlobSha256(sourceRoot, upstream.commitSha, "codex-rs/Cargo.lock", "Codex Cargo.lock") !== upstream.cargoLockSha256) fail("Codex Cargo.lock drifted");
+  if (gitBlobSha256(sourceRoot, upstream.commitSha, "LICENSE", "Codex LICENSE") !== upstream.licenseSha256) fail("Codex LICENSE drifted");
+  if (gitBlobSha256(sourceRoot, upstream.commitSha, "NOTICE", "Codex NOTICE") !== upstream.noticeSha256) fail("Codex NOTICE drifted");
+  const schemaPaths = git(sourceRoot, ["ls-tree", "-r", "--name-only", upstream.commitSha, "--", upstream.schemaRoot], "schema inventory")
+    .split("\n").filter(Boolean).sort();
+  if (schemaPaths.length !== upstream.schemaFileCount) fail("schema file count drifted");
+  if (schemaManifest(sourceRoot, upstream, schemaPaths) !== upstream.schemaManifestSha256) fail("schema manifest drifted");
+  if (canonicalSchemaTree(sourceRoot, upstream, schemaPaths) !== upstream.canonicalSchemaTreeSha256) {
+    fail("canonical schema tree drifted");
+  }
+  if (
+    git(sourceRoot, ["remote", "get-url", "origin"], "final source remote").replace(/\.git$/, "") !== upstream.repository ||
+    git(sourceRoot, ["cat-file", "-t", upstream.ref], "final source tag type") !== "tag" ||
+    git(sourceRoot, ["rev-parse", upstream.ref], "final source tag object") !== upstream.tagObjectSha ||
+    git(sourceRoot, ["rev-parse", `${upstream.ref}^{commit}`], "final source peeled commit") !== upstream.commitSha ||
+    git(sourceRoot, ["rev-parse", "HEAD"], "final source HEAD") !== upstream.commitSha ||
+    git(sourceRoot, ["rev-parse", `${upstream.commitSha}^{tree}`], "final source root tree") !== upstream.treeSha ||
+    git(sourceRoot, ["rev-parse", `${upstream.commitSha}:codex-rs/app-server`], "final App Server tree") !== upstream.appServerTreeSha ||
+    git(sourceRoot, ["rev-parse", `${upstream.commitSha}:codex-rs/app-server-protocol`], "final App Server protocol tree") !== upstream.appServerProtocolTreeSha
+  ) fail("source checkout changed during verification");
+
+  process.stdout.write("codex harness pinned upstream source: PASS\n");
