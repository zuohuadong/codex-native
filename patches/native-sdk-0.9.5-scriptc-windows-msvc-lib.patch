diff --git a/packages/core/node_modules/@scriptc/runtime/src/scr_win_dirent.h b/packages/core/node_modules/@scriptc/runtime/src/scr_win_dirent.h
new file mode 100644
index 0000000..84b2847
--- /dev/null
+++ b/packages/core/node_modules/@scriptc/runtime/src/scr_win_dirent.h
@@ -0,0 +1,241 @@
+#ifndef SCR_WIN_DIRENT_H
+#define SCR_WIN_DIRENT_H
+
+#if !defined(_WIN32) || !defined(_MSC_VER)
+#error "scr_win_dirent.h is only for the MSVC Windows runtime arm"
+#endif
+
+#include <errno.h>
+#include <limits.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <wchar.h>
+#include <windows.h>
+
+/* MSVC has no dirent.h. ScriptC paths are UTF-8, so enumerate through the
+ * wide Win32 API and convert names back to UTF-8 without the ANSI code page. */
+#define DT_UNKNOWN 0
+#define DT_FIFO 1
+#define DT_CHR 2
+#define DT_DIR 4
+#define DT_BLK 6
+#define DT_REG 8
+#define DT_LNK 10
+#define DT_SOCK 12
+
+struct dirent {
+  char d_name[MAX_PATH * 4];
+  unsigned char d_type;
+};
+
+typedef struct {
+  HANDLE handle;
+  WIN32_FIND_DATAW data;
+  bool first;
+  struct dirent entry;
+} DIR;
+
+static int scr_win_dirent_errno(DWORD error) {
+  switch (error) {
+  case ERROR_ACCESS_DENIED:
+  case ERROR_PRIVILEGE_NOT_HELD:
+    return EACCES;
+  case ERROR_BUFFER_OVERFLOW:
+  case ERROR_FILENAME_EXCED_RANGE:
+  case ERROR_INSUFFICIENT_BUFFER:
+    return ENAMETOOLONG;
+  case ERROR_NOT_ENOUGH_MEMORY:
+  case ERROR_OUTOFMEMORY:
+    return ENOMEM;
+  case ERROR_INVALID_HANDLE:
+    return EBADF;
+  case ERROR_DIRECTORY:
+    return ENOTDIR;
+  case ERROR_BAD_PATHNAME:
+  case ERROR_FILE_NOT_FOUND:
+  case ERROR_INVALID_DRIVE:
+  case ERROR_INVALID_NAME:
+  case ERROR_PATH_NOT_FOUND:
+    return ENOENT;
+  default:
+    return EIO;
+  }
+}
+
+static WCHAR *scr_win_utf8_wide(const char *path, size_t path_len) {
+  if (path_len > INT_MAX) {
+    SetLastError(ERROR_FILENAME_EXCED_RANGE);
+    return NULL;
+  }
+  int wide_len = path_len > 0
+    ? MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS,
+                          path, (int)path_len, NULL, 0)
+    : 0;
+  if (path_len > 0 && wide_len <= 0) return NULL;
+  WCHAR *wide = malloc(((size_t)wide_len + 1) * sizeof *wide);
+  if (!wide) {
+    SetLastError(ERROR_NOT_ENOUGH_MEMORY);
+    return NULL;
+  }
+  if (wide_len > 0) {
+    int converted = MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS,
+                                        path, (int)path_len, wide, wide_len);
+    if (converted != wide_len) {
+      DWORD error = GetLastError();
+      free(wide);
+      SetLastError(error);
+      return NULL;
+    }
+  }
+  wide[wide_len] = L'\0';
+  return wide;
+}
+
+static DIR *scr_win_opendir(const char *path) {
+  size_t path_len = strlen(path);
+  if (path_len == 0) {
+    errno = ENOENT;
+    return NULL;
+  }
+  WCHAR *wide = scr_win_utf8_wide(path, path_len);
+  if (!wide) {
+    errno = scr_win_dirent_errno(GetLastError());
+    return NULL;
+  }
+  DWORD attributes = GetFileAttributesW(wide);
+  if (attributes == INVALID_FILE_ATTRIBUTES ||
+      (attributes & FILE_ATTRIBUTE_DIRECTORY) == 0) {
+    DWORD error = attributes == INVALID_FILE_ATTRIBUTES
+      ? GetLastError()
+      : ERROR_DIRECTORY;
+    free(wide);
+    errno = scr_win_dirent_errno(error);
+    return NULL;
+  }
+  size_t wide_len = wcslen(wide);
+  const size_t extra = 3; /* optional separator, wildcard, NUL */
+  if (wide_len > (SIZE_MAX / sizeof(WCHAR)) - extra) {
+    free(wide);
+    errno = ENAMETOOLONG;
+    return NULL;
+  }
+  WCHAR *pattern = malloc((wide_len + extra) * sizeof *pattern);
+  if (!pattern) {
+    free(wide);
+    errno = ENOMEM;
+    return NULL;
+  }
+  memcpy(pattern, wide, wide_len * sizeof *pattern);
+  free(wide);
+  size_t at = wide_len;
+  if (pattern[at - 1] != L'\\' && pattern[at - 1] != L'/') pattern[at++] = L'\\';
+  pattern[at++] = L'*';
+  pattern[at] = L'\0';
+
+  DIR *dir = malloc(sizeof *dir);
+  if (!dir) {
+    free(pattern);
+    errno = ENOMEM;
+    return NULL;
+  }
+  dir->handle = FindFirstFileW(pattern, &dir->data);
+  DWORD error = dir->handle == INVALID_HANDLE_VALUE ? GetLastError() : ERROR_SUCCESS;
+  free(pattern);
+  if (dir->handle == INVALID_HANDLE_VALUE) {
+    free(dir);
+    errno = scr_win_dirent_errno(error);
+    return NULL;
+  }
+  dir->first = true;
+  return dir;
+}
+
+static int scr_win_remove_reparse(const char *path, size_t path_len,
+                                  bool *removed, const char **operation) {
+  *removed = false;
+  *operation = "lstat";
+  WCHAR *wide = scr_win_utf8_wide(path, path_len);
+  if (!wide) return scr_win_dirent_errno(GetLastError());
+  DWORD attributes = GetFileAttributesW(wide);
+  if (attributes == INVALID_FILE_ATTRIBUTES) {
+    DWORD error = GetLastError();
+    free(wide);
+    return scr_win_dirent_errno(error);
+  }
+  if ((attributes & FILE_ATTRIBUTE_REPARSE_POINT) == 0) {
+    free(wide);
+    return 0;
+  }
+  bool directory = (attributes & FILE_ATTRIBUTE_DIRECTORY) != 0;
+  *operation = directory ? "rmdir" : "unlink";
+  BOOL ok = directory ? RemoveDirectoryW(wide) : DeleteFileW(wide);
+  DWORD error = ok ? ERROR_SUCCESS : GetLastError();
+  free(wide);
+  if (!ok) return scr_win_dirent_errno(error);
+  *removed = true;
+  return 0;
+}
+
+static struct dirent *scr_win_readdir(DIR *dir) {
+  if (!dir || dir->handle == INVALID_HANDLE_VALUE) {
+    errno = EBADF;
+    return NULL;
+  }
+  if (dir->first) {
+    dir->first = false;
+  } else if (!FindNextFileW(dir->handle, &dir->data)) {
+    DWORD error = GetLastError();
+    if (error != ERROR_NO_MORE_FILES) errno = scr_win_dirent_errno(error);
+    return NULL;
+  }
+  int bytes = WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS,
+                                  dir->data.cFileName, -1,
+                                  dir->entry.d_name,
+                                  (int)sizeof dir->entry.d_name,
+                                  NULL, NULL);
+  if (bytes <= 0) {
+    errno = scr_win_dirent_errno(GetLastError());
+    return NULL;
+  }
+  DWORD attributes = dir->data.dwFileAttributes;
+  if ((attributes & FILE_ATTRIBUTE_REPARSE_POINT) != 0) {
+    dir->entry.d_type = dir->data.dwReserved0 == IO_REPARSE_TAG_SYMLINK ||
+                        dir->data.dwReserved0 == IO_REPARSE_TAG_MOUNT_POINT
+      ? DT_LNK
+      : DT_UNKNOWN;
+  } else if ((attributes & FILE_ATTRIBUTE_DIRECTORY) != 0) {
+    dir->entry.d_type = DT_DIR;
+  } else if ((attributes & FILE_ATTRIBUTE_DEVICE) != 0) {
+    dir->entry.d_type = DT_CHR;
+  } else {
+    dir->entry.d_type = DT_REG;
+  }
+  return &dir->entry;
+}
+
+static struct dirent *scr_win_readdir_next(DIR *dir, int *error) {
+  errno = 0;
+  struct dirent *entry = scr_win_readdir(dir);
+  *error = entry ? 0 : errno;
+  return entry;
+}
+
+static int scr_win_closedir(DIR *dir) {
+  if (!dir) {
+    errno = EBADF;
+    return -1;
+  }
+  BOOL ok = dir->handle != INVALID_HANDLE_VALUE && FindClose(dir->handle);
+  DWORD error = ok ? ERROR_SUCCESS : GetLastError();
+  free(dir);
+  if (!ok) errno = scr_win_dirent_errno(error);
+  return ok ? 0 : -1;
+}
+
+#define opendir scr_win_opendir
+#define readdir scr_win_readdir
+#define closedir scr_win_closedir
+
+#endif
