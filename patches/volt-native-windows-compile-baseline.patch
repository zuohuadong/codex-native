diff --git a/native-ui/src/host_calls_windows.zig b/native-ui/src/host_calls_windows.zig
new file mode 100644
index 0000000..b24e87b
--- /dev/null
+++ b/native-ui/src/host_calls_windows.zig
@@ -0,0 +1,130 @@
+const std = @import("std");
+const native_sdk = @import("native_sdk");
+
+pub const SurfaceKind = enum { code_diff, code_file, workspace_file, terminal };
+
+var synthetic_surface_replay_authorized = false;
+var synthetic_surface_replay_active = false;
+var surface_sink: ?*const fn (SurfaceKind, []const u8) bool = null;
+var task_boundary_sink: ?*const fn () void = null;
+var terminal_boundary_sink: ?*const fn () void = null;
+
+pub fn setSyntheticSurfaceReplayAuthorized(authorized: bool, replay_active: bool) void {
+    synthetic_surface_replay_authorized = authorized;
+    synthetic_surface_replay_active = authorized and replay_active;
+}
+
+pub fn syntheticSurfaceReplayAuthorized() bool {
+    return synthetic_surface_replay_authorized;
+}
+
+pub fn syntheticSurfaceReplayActive() bool {
+    return synthetic_surface_replay_authorized and synthetic_surface_replay_active;
+}
+
+pub fn applySyntheticReplayCodeCompletion(_: []const u8) ?bool {
+    return null;
+}
+
+pub fn beginSyntheticReplayCodeWrite(_: i64) bool {
+    return false;
+}
+
+pub fn beginSyntheticReplayCodeClose(_: i64) bool {
+    return false;
+}
+
+pub fn bindSurfaceSink(sink: *const fn (SurfaceKind, []const u8) bool) void {
+    surface_sink = sink;
+}
+
+pub fn bindTaskBoundarySink(sink: *const fn () void) void {
+    task_boundary_sink = sink;
+}
+
+pub fn bindTerminalBoundarySink(sink: *const fn () void) void {
+    terminal_boundary_sink = sink;
+}
+
+pub fn binding(effects: anytype) native_sdk.HostCallBinding {
+    const Effects = @TypeOf(effects.*);
+    const Callbacks = struct {
+        fn send(_: *anyopaque, _: []const u8, _: []const u8) void {}
+
+        fn request(context: *anyopaque, name: []const u8, key: u64, payload: []const u8) void {
+            const bound: *Effects = @ptrCast(@alignCast(context));
+            if (std.mem.eql(u8, name, "volt.bootstrap.status")) {
+                const failure = if (payload.len == 0) "bootstrap_unverified" else "invalid_bootstrap_request";
+                bound.feedHostResult(key, false, failure) catch {};
+                return;
+            }
+            bound.feedHostResult(key, false, "agentd_unbound") catch {};
+        }
+
+        fn cancel(_: *anyopaque, _: u64) void {}
+    };
+    return .{
+        .context = effects,
+        .send_fn = Callbacks.send,
+        .request_fn = Callbacks.request,
+        .cancel_fn = Callbacks.cancel,
+    };
+}
+
+pub fn poll(_: anytype) void {}
+
+pub fn deinit() void {
+    surface_sink = null;
+    task_boundary_sink = null;
+    terminal_boundary_sink = null;
+    synthetic_surface_replay_authorized = false;
+    synthetic_surface_replay_active = false;
+}
+
+pub fn testingDisconnectTransport() bool {
+    return false;
+}
+
+pub fn testingStageIndeterminateTerminalInput(_: u64) ?u64 {
+    return null;
+}
+
+pub fn testingReconnectState() [4]u64 {
+    return .{ 4, 0, 0, 0 };
+}
+
+test "Windows host requests fail closed until authority is bound" {
+    const FakeEffects = struct {
+        key: u64 = 0,
+        ok: bool = true,
+        result: [64]u8 = undefined,
+        result_len: usize = 0,
+
+        fn feedHostResult(self: *@This(), key: u64, ok: bool, bytes: []const u8) !void {
+            self.key = key;
+            self.ok = ok;
+            self.result_len = bytes.len;
+            @memcpy(self.result[0..bytes.len], bytes);
+        }
+
+        fn resultSlice(self: *const @This()) []const u8 {
+            return self.result[0..self.result_len];
+        }
+    };
+
+    var effects = FakeEffects{};
+    const bound = binding(&effects);
+
+    bound.request_fn(bound.context, "volt.bootstrap.status", 7, "");
+    try std.testing.expectEqual(@as(u64, 7), effects.key);
+    try std.testing.expect(!effects.ok);
+    try std.testing.expectEqualStrings("bootstrap_unverified", effects.resultSlice());
+
+    bound.request_fn(bound.context, "volt.bootstrap.status", 8, "unexpected");
+    try std.testing.expectEqualStrings("invalid_bootstrap_request", effects.resultSlice());
+
+    bound.request_fn(bound.context, "volt.task.start", 9, "{}");
+    try std.testing.expectEqual(@as(u64, 9), effects.key);
+    try std.testing.expect(!effects.ok);
+    try std.testing.expectEqualStrings("agentd_unbound", effects.resultSlice());
+}
