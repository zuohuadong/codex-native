+    // Modifier transitions preview the current chord but do not complete it.
+    if (event.type == NSEventTypeFlagsChanged) {
+        [self emitShortcutWithId:@"__capture__"
+                             key:@""
+                       modifiers:NativeSdkModifierFlagsForEvent(event)
+                            event:event];
+        return YES;
+    }
+    if (event.type != NSEventTypeKeyDown) return NO;
+
+    // The local monitor must swallow repeats while capture is active, but a
+    // repeat is never the one accepted chord. Escape is an explicit cancel.
+    if (event.isARepeat) return YES;
